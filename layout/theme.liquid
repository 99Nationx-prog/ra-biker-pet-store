<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ page_title | escape }}{% if current_tags %} — {{ current_tags | join: ', ' }}{% endif %}</title>
{{ content_for_header }}
{{ 'base.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mobile-navigation.js' | asset_url }}" defer></script>
</head>
<body>
<a class="skip-link" href="#MainContent">Skip to content</a>
{% section 'header' %}
<main id="MainContent" role="main">{{ content_for_layout }}</main>
{% section 'footer' %}
{% render 'mobile-bottom-nav' %}
</body></html>