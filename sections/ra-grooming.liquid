."}],"presets":[{"name":"Ra Biker grooming"}],"blocks":[{"type":"customer_review","name":"Customer review","settings":[{"type":"text","id":"author","label":"Customer name (with consent)"},{"type":"range","id":"stars","label":"Customer rating","min":1,"max":5,"step":1,"default":5},{"type":"text","id":"date","label":"Review date"},{"type":"textarea","id":"body","label":"Genuine customer review"}]}]}{% endschema %}