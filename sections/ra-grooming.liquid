#ra-cart-{{ section.id }} .rc-reassure p{font-size:13px;line-height:1.45;margin:0 0 12px}
#ra-cart-{{ section.id }} .rc-reassure ul{list-style:none;padding:10px 0 0;margin:0 auto 10px;border-top:1px solid #d4ddd2;display:grid;grid-template-columns:1fr 1fr;gap:8px;text-align:left;font-size:12px}
#ra-cart-{{ section.id }} .rc-reassure li{display:flex;gap:6px;align-items:center}
#ra-cart-{{ section.id }} .rc-reassure li svg{flex:none;width:16px;height:16px}
