#ra-cart-{{ section.id }} button:disabled{opacity:.5;cursor:wait}
#ra-cart-{{ section.id }} .rc-items{flex:1;overflow:auto;padding:20px}
#ra-cart-{{ section.id }} .rc-item{display:flex;gap:14px;padding:14px 0;border-bottom:1px solid #ddd}
