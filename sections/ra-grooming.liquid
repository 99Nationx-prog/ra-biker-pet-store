{{ 'ra-grooming.css' | asset_url | stylesheet_tag }}
{% assign p = section.settings.product | default: product %}
{% if p == blank %}{% assign p = all_products['ra-biker-grooming-vacuum-kit'] %}{% endif %}
{% assign v = p.selected_or_first_available_variant %}
{% assign form_id = 'ra-form-' | append: section.id %}
<section class="ra-groom" id="ra-{{ section.id }}">
<div class="ra-hero">
{% if section.settings.hero != blank %}{{ section.settings.hero | image_url: width: 1600 | image_tag: class: 'ra-hero-image', loading: 'eager' }}{% elsif p.featured_image %}{{ p.featured_image | image_url: width: 1200 | image_tag: class: 'ra-hero-image' }}{% endif %}
<div class="ra-copy"><strong>{{ p.title | default: 'Ra Biker Grooming Vacuum Kit' | escape }}</strong><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.description | escape }}</p>
{% if section.settings.rating != blank and section.settings.review_count != blank and section.settings.review_link != blank %}<a class="ra-rating" href="{{ section.settings.review_link }}"><span aria-hidden="true">★★★★★</span> {{ section.settings.rating | escape }} ({{ section.settings.review_count | escape }} reviews)<small>Manufacturer-sourced reviews</small></a>{% endif %}
{% if v != blank %}<div class="ra-price">{{ v.price | money }}</div>{% endif %}
{% if p != blank %}{% form 'product', p, id: form_id %}<input type="hidden" name="id" value="{{ v.id }}"><button class="ra-buy" type="submit" {% unless v.available %}disabled{% endunless %}>{% if v.available %}Add to Cart{% else %}Sold out{% endif %}</button>{% endform %}{% else %}<p>Select a product in Theme Editor.</p>{% endif %}
<a class="ra-watch" href="#ra-demo-{{ section.id }}">▶ Watch It in Action</a></div></div>
<div class="ra-benefits">{% for i in (1..4) %}{% assign key = 'benefit' | append: i %}<div><svg viewBox="0 0 32 32" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">{% case i %}{% when 1 %}<ellipse cx="7" cy="10" rx="3" ry="4"/><ellipse cx="16" cy="6" rx="3" ry="4"/><ellipse cx="25" cy="10" rx="3" ry="4"/><path d="M16 14c-5 0-12 8-10 12s7 1 10 1 8 3 10-1-5-12-10-12Z"/>{% when 2 %}<path d="M2 10h19c8 0 8-9 2-9M2 16h26c5 0 5 8-2 8M2 22h12c6 0 6 8 0 8"/>{% when 3 %}<path d="m16 2 12 5v9c0 7-12 14-12 14S4 23 4 16V7Z"/><path d="m10 15 4 4 8-9"/>{% when 4 %}<circle cx="16" cy="16" r="6"/><path d="m12 2 8 0 1 5 5 2 4 5-3 5-1 6-6 1-4 4-5-4-6-1-1-6-3-5 4-5 5-2Z"/>{% endcase %}</svg><br>{{ section.settings[key] | escape }}</div>{% endfor %}</div>
<div id="ra-demo-{{ section.id }}" class="ra-demo">{% if section.settings.demo != blank %}{{ section.settings.demo | video_tag: controls: true, preload: 'none', image_size: '1000x' }}{% elsif section.settings.poster != blank %}{{ section.settings.poster | image_url: width: 1200 | image_tag }}<p>Demonstration video coming soon.</p>{% else %}<p>Demonstration video coming soon.</p>{% endif %}</div>
<h2>How It Works</h2><div class="ra-steps">{% assign names = 'Brush|Collect|Empty' | split: '|' %}{% assign descriptions = 'Gently groom your dog|The vacuum captures loose hair|Quickly remove and dispose of the fur' | split: '|' %}{% for name in names %}{% assign key = 'step' | append: forloop.index %}<div><b class="ra-number">{{ forloop.index }}</b>{% if section.settings[key] != blank %}{{ section.settings[key] | image_url: width: 300 | image_tag }}{% endif %}<h3>{{ name }}</h3><p>{{ descriptions[forloop.index0] }}</p></div>{% endfor %}</div>
<div class="ra-kit"><h2>Everything in the Kit</h2><div class="ra-accessories">{% assign names = 'Grooming Brush|Deshedding Tool|Clipper|Cleaning Brush|Crevice Tool' | split: '|' %}{% for name in names %}{% assign key = 'kit' | append: forloop.index %}{% if section.settings[key] != blank %}<div>{{ section.settings[key] | image_url: width: 240 | image_tag }}<p>{{ name }}</p></div>{% endif %}{% endfor %}</div></div>
{% if p != blank %}<div class="ra-sticky"><strong>{{ v.price | money }}</strong><button class="ra-buy" form="{{ form_id }}" type="submit" {% unless v.available %}disabled{% endunless %}>{% if v.available %}Add to Cart{% else %}Sold out{% endif %}</button></div>{% endif %}
<script>(function(){const root=document.getElementById('ra-{{ section.id }}');if(!root)return;const watch=root.querySelector('.ra-watch');if(watch)watch.addEventListener('click',()=>{const video=root.querySelector('video');if(video)video.play().catch(()=>{});});const sticky=root.querySelector('.ra-sticky'),buy=root.querySelector('.ra-copy .ra-buy');if(sticky&&buy&&'IntersectionObserver'in window){new IntersectionObserver(entries=>{sticky.classList.toggle('ra-hidden',entries[0].isIntersecting);}).observe(buy);}})();</script></section>
{% schema %}{"name":"Ra Biker grooming","settings":[{"type":"product","id":"product","label":"Grooming product"},{"type":"image_picker","id":"hero","label":"Hero lifestyle image"},{"type":"text","id":"heading","label":"Headline","default":"Brush your dog at home. Keep the fur out of your house."},{"type":"textarea","id":"description","label":"Description","default":"Brush, de-shed, and trim your dog while a built-in vacuum collects loose hair as you work."},{"type":"video","id":"demo","label":"Demonstration video"},{"type":"image_picker","id":"poster","label":"Video poster"},{"type":"text","id":"rating","label":"Confirmed manufacturer rating"},{"type":"text","id":"review_count","label":"Confirmed review count"},{"type":"url","id":"review_link","label":"Manufacturer review source"},{"type":"image_picker","id":"step1","label":"Step 1 image"},{"type":"image_picker","id":"step2","label":"Step 2 image"},{"type":"image_picker","id":"step3","label":"Step 3 image"},{"type":"image_picker","id":"kit1","label":"Accessory 1 image"},{"type":"image_picker","id":"kit2","label":"Accessory 2 image"},{"type":"image_picker","id":"kit3","label":"Accessory 3 image"},{"type":"image_picker","id":"kit4","label":"Accessory 4 image"},{"type":"image_picker","id":"kit5","label":"Accessory 5 image"},{"type":"text","id":"benefit1","label":"Benefit 1","default":"Cleaner Home"},{"type":"text","id":"benefit2","label":"Benefit 2","default":"Groom at Home"},{"type":"text","id":"benefit3","label":"Benefit 3","default":"Collect Loose Fur"},{"type":"text","id":"benefit4","label":"Benefit 4","default":"Easy to Use"}],"presets":[{"name":"Ra Biker grooming"}]}{% endschema %}