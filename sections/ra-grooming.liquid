#ra-cart-{{ section.id }} .rc-info{flex:1;min-width:0}
#ra-cart-{{ section.id }} .rc-qty{display:flex;align-items:center;gap:10px;margin-top:10px}
#ra-cart-{{ section.id }} .rc-remove{margin-left:auto;border:0;text-decoration:underline;font-size:12px}
#ra-cart-{{ section.id }} .rc-foot{border-top:1px solid #d8d8ce;border-bottom:0;padding-bottom:max(20px,env(safe-area-inset-bottom))}
#ra-cart-{{ section.id }} .rc-row{display:flex;justify-content:space-between;margin:10px 0}
#ra-cart-{{ section.id }} .rc-note{background:#e7efe5;padding:12px;border-radius:7px;font-size:14px}
#ra-cart-{{ section.id }} .rc-checkout{display:block;background:#06472d;color:white;text-align:center;padding:15px;border-radius:7px;text-decoration:none;font-weight:700;margin:15px 0}
#ra-cart-{{ section.id }} .rc-checkout[aria-disabled=true]{pointer-events:none;opacity:.5}
#ra-cart-{{ section.id }} .rc-continue{display:block;margin:auto;border:0;text-decoration:underline}
#ra-cart-{{ section.id }} .rc-error{color:#a32020;padding:0 20px}
#ra-cart-{{ section.id }} .rc-trust{text-align:center;font-size:12px;margin:12px 0 0}
#ra-cart-{{ section.id }} .rc-pay{display:flex;justify-content:center;flex-wrap:wrap;gap:5px;list-style:none;padding:0}
#ra-cart-{{ section.id }} .rc-reassure{padding:20px 4px 8px;text-align:center}
