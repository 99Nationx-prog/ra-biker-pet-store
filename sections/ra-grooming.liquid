#ra-cart-{{ section.id }} .rc-foot{flex-shrink:0;max-height:65%;overflow:auto}
#ra-cart-{{ section.id }} .rc-items{min-height:0}
@media(prefers-reduced-motion:reduce){#ra-cart-{{ section.id }}[open]{animation:none}}
</style>
<dialog id="ra-cart-{{ section.id }}" aria-labelledby="ra-cart-title-{{ section.id }}">
<div class="rc-head"><h2 id="ra-cart-title-{{ section.id }}">Your Cart (<span data-rc-count>0</span>)</h2><button type="button" data-rc-close aria-label="Close cart">×</button></div>
<div class="rc-items" data-rc-items aria-live="polite"></div><template data-rc-reassure><aside class="rc-reassure"><h3>A Happier Dog. A Cleaner Home.</h3><p>Less fur on your furniture, less mess on your floors, and more quality time with your furry best friend.</p><ul>{% assign promises = 'Free U.S. Shipping|30-Day Returns|Safe & Secure Checkout|Friendly Customer Support' | split: '|' %}{% for promise in promises %}<li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg>{{ promise | escape }}</li>{% endfor %}</ul><p><em>Because your dog deserves the best — and so do you.</em></p></aside></template><p class="rc-error" data-rc-error role="alert" hidden></p>
<div class="rc-foot"><div class="rc-note">Free U.S. shipping</div><div class="rc-row"><span>Subtotal</span><strong data-rc-total>—</strong></div><div class="rc-row"><span>Shipping (U.S.)</span><strong>FREE</strong></div><div class="rc-row"><strong>Estimated total</strong><strong data-rc-total>—</strong></div><small>Taxes and any applicable charges calculated at checkout.</small><a class="rc-checkout" href="{{ routes.root_url }}checkout" aria-disabled="true">Secure Checkout</a><button type="button" class="rc-continue" data-rc-close>Continue Shopping</button><ul class="rc-pay">{% for type in shop.enabled_payment_types %}<li>{{ type | payment_type_svg_tag }}</li>{% endfor %}</ul><p class="rc-trust">30-Day Returns · Secure Payment</p></div>
</dialog>
<script>
(function(){
const root=document.getElementById('ra-{{ section.id }}'), drawer=document.getElementById('ra-cart-{{ section.id }}'), form=document.getElementById({{ form_id | json }});
if(!root||!drawer||!drawer.showModal)return;
const base={{ routes.root_url | json }}, items=drawer.querySelector('[data-rc-items]'), error=drawer.querySelector('[data-rc-error]'), checkout=drawer.querySelector('.rc-checkout');
let busy=false,previous=null,oldOverflow='',currency={{ cart.currency.iso_code | default: shop.currency | json }};
const money=n=>new Intl.NumberFormat(undefined,{style:'currency',currency}).format(n/100);
const node=(tag,txt,cls)=>{const el=document.createElement(tag);if(txt!==undefined)el.textContent=txt;if(cls)el.className=cls;return el;};
async function api(path,body){const res=await fetch(base+path,{method:body?'POST':'GET',headers:{Accept:'application/json',...(body?{'Content-Type':'application/json'}:{})},...(body?{body:JSON.stringify(body)}:{})});const data=await res.json();if(!res.ok)throw Error(typeof data.description==='string'?data.description:'Unable to update cart. Please try again.');return data;}
function render(cart){currency=cart.currency||currency;items.replaceChildren();drawer.querySelector('[data-rc-count]').textContent=cart.item_count;drawer.querySelectorAll('[data-rc-total]').forEach(el=>el.textContent=money(cart.total_price));checkout.setAttribute('aria-disabled',String(!cart.item_count));document.querySelectorAll('.mobile-cart-count').forEach(el=>el.textContent=cart.item_count);document.querySelectorAll('.header-actions a').forEach(el=>{if(el.getAttribute('href')==={{ routes.cart_url | json }}){el.setAttribute('aria-label','Shopping bag, '+cart.item_count+' items');const label=el.querySelector('.desktop-action-label');if(label)label.textContent='Bag ('+cart.item_count+')';}});if(!cart.items.length)items.append(node('p','Your cart is empty.'));
for(const item of cart.items){const row=node('div',undefined,'rc-item'),info=node('div',undefined,'rc-info');const fallback={% if section.settings.lower_banner_image.width > 0 %}{{ section.settings.lower_banner_image | image_url: width: 360 | json }}{% elsif section.settings.hero.width > 0 %}{{ section.settings.hero | image_url: width: 360 | json }}{% else %}null{% endif %};const image=item.image||(String(item.product_id)==={{ p.id | append: '' | json }}?fallback:null);if(image){const img=node('img');img.src=image;img.alt=item.product_title;row.append(img);}info.append(node('strong',item.product_title));if(item.variant_title&&item.variant_title!=='Default Title')info.append(node('div',item.variant_title));info.append(node('div',money(item.final_line_price)));const qty=node('div',undefined,'rc-qty');for(const [label,value,aria] of [['−',item.quantity-1,'Decrease quantity'],['+',item.quantity+1,'Increase quantity'],['Remove',0,'Remove item']]){const b=node('button',label,label==='Remove'?'rc-remove':'');b.type='button';b.setAttribute('aria-label',aria+' '+item.product_title);b.addEventListener('click',()=>run(async()=>render(await api('cart/change.js',{id:item.key,quantity:value}))));qty.append(b);if(label==='−')qty.append(node('span',String(item.quantity)));}info.append(qty);row.append(info);items.append(row);}if(cart.item_count)items.append(drawer.querySelector('[data-rc-reassure]').content.cloneNode(true));}
function open(){if(drawer.open)return;previous=document.activeElement;oldOverflow=document.body.style.overflow;drawer.showModal();document.body.style.overflow='hidden';}
drawer.addEventListener('close',()=>{document.body.style.overflow=oldOverflow;if(previous)previous.focus();});drawer.querySelectorAll('[data-rc-close]').forEach(b=>b.addEventListener('click',()=>drawer.close()));drawer.addEventListener('click',e=>{if(e.target===drawer){const b=drawer.getBoundingClientRect();if(e.clientX<b.left||e.clientX>b.right||e.clientY<b.top||e.clientY>b.bottom)drawer.close();}});
async function run(fn){if(busy)return;busy=true;error.hidden=true;drawer.setAttribute('aria-busy','true');checkout.setAttribute('aria-disabled','true');const buttons=[...root.querySelectorAll('button[type=submit]'),...drawer.querySelectorAll('.rc-qty button')].filter(b=>!b.disabled);buttons.forEach(b=>b.disabled=true);try{await fn();}catch(e){open();error.textContent=e.message||'Unable to update cart. Please try again.';error.hidden=false;try{render(await api('cart.js'));}catch(_){checkout.setAttribute('aria-disabled','true');}}finally{busy=false;drawer.removeAttribute('aria-busy');buttons.forEach(b=>b.disabled=false);}}
if(form)form.addEventListener('submit',e=>{e.preventDefault();run(async()=>{open();items.textContent='Adding to cart…';await api('cart/add.js',{items:[{id:new FormData(form).get('id'),quantity:1}]});render(await api('cart.js'));});});
document.querySelectorAll('.header-actions a').forEach(a=>{if(a.getAttribute('href')==={{ routes.cart_url | json }})a.addEventListener('click',e=>{if(e.metaKey||e.ctrlKey||e.shiftKey||e.altKey)return;e.preventDefault();run(async()=>{open();items.textContent='Loading cart…';render(await api('cart.js'));});});});
checkout.addEventListener('click',e=>{if(busy||checkout.getAttribute('aria-disabled')==='true')e.preventDefault();});
})();
</script>

