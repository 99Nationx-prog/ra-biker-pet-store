{{ 'ra-grooming.css' | asset_url | stylesheet_tag }}
{% assign p = section.settings.product | default: product %}
{% if p == blank %}{% assign p = all_products['ra-biker-grooming-vacuum-kit'] %}{% endif %}
{% if p == blank %}{% for candidate in collections.all.products %}{% assign candidate_title = candidate.title | downcase %}{% if candidate_title contains 'grooming' and candidate_title contains 'vacuum' %}{% assign p = candidate %}{% break %}{% endif %}{% endfor %}{% endif %}
{% assign v = p.selected_or_first_available_variant %}
{% assign form_id = 'ra-form-' | append: section.id %}
<section class="ra-groom" id="ra-{{ section.id }}">
<div class="ra-hero">
{% if section.settings.hero.width > 0 %}{{ section.settings.hero | image_url: width: 1600 | image_tag: class: 'ra-hero-image', loading: 'eager' }}{% elsif p.featured_image.width > 0 %}{{ p.featured_image | image_url: width: 1200 | image_tag: class: 'ra-hero-image' }}{% endif %}
<div class="ra-copy"><strong>{{ p.title | default: 'Ra Biker Grooming Vacuum Kit' | escape }}</strong><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.description | escape }}</p>
{% if section.settings.rating != blank and section.settings.review_count != blank and section.settings.review_link != blank %}<a class="ra-rating" href="{{ section.settings.review_link }}"><span aria-hidden="true">★★★★★</span> {{ section.settings.rating | escape }} ({{ section.settings.review_count | escape }} reviews)<small>Manufacturer-sourced reviews</small></a>{% endif %}
{% if v != blank %}<div class="ra-price">{{ v.price | money }}</div>{% endif %}
{% if v.id != blank %}{% form 'product', p, id: form_id %}<input type="hidden" name="id" value="{{ v.id }}"><button class="ra-buy" type="submit" {% unless v.available %}disabled{% endunless %}>{% if v.available %}<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 2h3l4 14h12l3-10H5"/><circle cx="9" cy="21" r="1"/><circle cx="19" cy="21" r="1"/></svg> Add to Cart{% else %}Sold out{% endif %}</button>{% endform %}{% else %}<div class="ra-price">$69.99</div><button class="ra-buy" type="button" disabled title="Product currently unavailable"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 2h3l4 14h12l3-10H5"/><circle cx="9" cy="21" r="1"/><circle cx="19" cy="21" r="1"/></svg> Add to Cart</button>{% endif %}
<a class="ra-watch" href="#ra-demo-{{ section.id }}"><span class="ra-play-small" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 4.5v15L20 12z"/></svg></span> Watch It in Action</a></div></div>
<div class="ra-benefits">{% for i in (1..4) %}{% assign key = 'benefit' | append: i %}<div><svg viewBox="0 0 32 32" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">{% case i %}{% when 1 %}<ellipse cx="7" cy="10" rx="3" ry="4"/><ellipse cx="16" cy="6" rx="3" ry="4"/><ellipse cx="25" cy="10" rx="3" ry="4"/><path d="M16 14c-5 0-12 8-10 12s7 1 10 1 8 3 10-1-5-12-10-12Z"/>{% when 2 %}<path d="M2 10h19c8 0 8-9 2-9M2 16h26c5 0 5 8-2 8M2 22h12c6 0 6 8 0 8"/>{% when 3 %}<path d="m16 2 12 5v9c0 7-12 14-12 14S4 23 4 16V7Z"/><path d="m10 15 4 4 8-9"/>{% when 4 %}<circle cx="16" cy="16" r="6"/><path d="M13 2h6l1 4 3 2 4-1 3 5-3 3v3l3 3-3 5-4-1-3 2-1 3h-6l-1-3-3-2-4 1-3-5 3-3v-3l-3-3 3-5 4 1 3-2z"/>{% endcase %}</svg><br>{{ section.settings[key] | escape }}</div>{% endfor %}</div>
<div id="ra-demo-{{ section.id }}" class="ra-demo">{% if section.settings.demo != blank %}{{ section.settings.demo | video_tag: controls: true, preload: 'none', image_size: '1000x' }}{% elsif section.settings.poster.width > 0 %}{{ section.settings.poster | image_url: width: 1200 | image_tag }}{% if request.design_mode %}<p>Choose Demonstration video in section settings</p>{% endif %}{% else %}<div class="ra-media-placeholder"><button type="button" class="ra-play" aria-label="Video setup" data-ra-message="{% if request.design_mode %}Select Demonstration video in the Ra Biker grooming section settings.{% else %}Demonstration video not yet available.{% endif %}"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 4.5v15L20 12z"/></svg></button><small>{% if request.design_mode %}Select demonstration video in section settings{% else %}Demonstration video not yet available{% endif %}</small></div>{% endif %}</div>
<h2 class="ra-how-heading">How It Works</h2><div class="ra-steps">{% assign names = 'Brush|Collect|Empty' | split: '|' %}{% assign descriptions = 'Gently groom your dog|The vacuum captures loose hair|Quickly remove and dispose of the fur' | split: '|' %}{% for name in names %}{% assign key = 'step' | append: forloop.index %}<div><b class="ra-number">{{ forloop.index }}</b>{% if section.settings[key].width > 0 %}{{ section.settings[key] | image_url: width: 300 | image_tag }}{% else %}<button type="button" class="ra-step-placeholder" data-ra-message="{% if request.design_mode %}Select the {{ name | escape }} image in the Ra Biker grooming section settings.{% else %}{{ name | escape }} image not yet available.{% endif %}">{% if request.design_mode %}Select image{% else %}Image coming soon{% endif %}</button>{% endif %}<h3>{{ name }}</h3><p>{{ descriptions[forloop.index0] }}</p></div>{% endfor %}</div>
<div class="ra-kit"><h2>Everything in the Kit</h2><div class="ra-accessories">{% assign names = 'Grooming Brush|Deshedding Tool|Clipper|Cleaning Brush|Crevice Tool' | split: '|' %}{% for name in names %}{% assign key = 'kit' | append: forloop.index %}<div>{% if section.settings[key].width > 0 %}{{ section.settings[key] | image_url: width: 240 | image_tag }}{% else %}<button type="button" class="ra-kit-placeholder" data-ra-message="{% if request.design_mode %}Select accessory {{ forloop.index }} in the Ra Biker grooming section settings.{% else %}Accessory image not yet available.{% endif %}">{% if request.design_mode %}Select image{% else %}Image coming soon{% endif %}</button>{% endif %}<p>{{ name }}</p></div>{% endfor %}</div></div>
<div class="ra-lower"><div class="ra-lower-grid"><div class="ra-lower-proof"><div class="ra-lower-photo">{% if section.settings.lower_benefit_image.width > 0 %}{{ section.settings.lower_benefit_image | image_url: width: 1000 | image_tag: loading: 'lazy' }}{% else %}<span>{% if request.design_mode %}Select dog and vacuum benefits photo in section settings{% else %}Product image coming soon{% endif %}</span>{% endif %}</div><ul>{% for i in (0..4) %}{% assign k = 'lower_benefit' | append: i %}<li><span aria-hidden="true">✓</span>{{ section.settings[k] | escape }}</li>{% endfor %}</ul></div><div class="ra-lower-faq"><h2>Frequently Asked Questions</h2>{% for i in (0..4) %}{% assign q = 'faq_q' | append: i %}{% assign a = 'faq_a' | append: i %}<details><summary>{{ section.settings[q] | escape }}<span aria-hidden="true"></span></summary><p>{{ section.settings[a] | escape | newline_to_br }}</p></details>{% endfor %}</div></div><div class="ra-lower-banner">{% if section.settings.lower_banner_image.width > 0 %}{{ section.settings.lower_banner_image | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'ra-lower-banner-img' }}{% endif %}<div class="ra-lower-banner-copy"><h2>{{ section.settings.lower_heading | escape }}</h2><p>{{ section.settings.lower_copy | escape }}</p>{% if v.id != blank %}<button type="submit" form="{{ form_id }}" {% unless v.available %}disabled{% endunless %}>{% if v.available %}🛒 Add to Cart — {{ v.price | money }}{% else %}Sold out{% endif %}</button>{% else %}<button type="button" disabled>🛒 Add to Cart — $69.99</button>{% endif %}</div></div></div>
{% if v.id != blank %}<div class="ra-sticky"><strong>{{ v.price | money }}</strong><button class="ra-buy" form="{{ form_id }}" type="submit" {% unless v.available %}disabled{% endunless %}>{% if v.available %}<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 2h3l4 14h12l3-10H5"/><circle cx="9" cy="21" r="1"/><circle cx="19" cy="21" r="1"/></svg> Add to Cart{% else %}Sold out{% endif %}</button></div>{% else %}<div class="ra-sticky"><strong>$69.99</strong><button class="ra-buy" disabled><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 2h3l4 14h12l3-10H5"/><circle cx="9" cy="21" r="1"/><circle cx="19" cy="21" r="1"/></svg> Add to Cart</button></div>{% endif %}
<script>(function(){const root=document.getElementById('ra-{{ section.id }}');if(!root)return;root.addEventListener("click",function(e){const b=e.target.closest("[data-ra-message]");if(b)window.alert(b.dataset.raMessage);});const watch=root.querySelector('.ra-watch');if(watch)watch.addEventListener('click',()=>{const video=root.querySelector('video');if(video)video.play().catch(()=>{});else if(root.querySelector(".ra-play"))root.querySelector(".ra-play").focus();});const sticky=root.querySelector('.ra-sticky'),buy=root.querySelector('.ra-copy .ra-buy');if(sticky&&buy&&'IntersectionObserver'in window){new IntersectionObserver(entries=>{sticky.classList.remove('ra-hidden');}).observe(buy);}})();</script><style>#ra-{{ section.id }} .ra-play-small{display:inline-flex;align-items:center;justify-content:center;background:#08432f;color:#fff;border-radius:50%;width:24px;height:24px;flex:none}#ra-{{ section.id }} .ra-play-small svg{width:15px;height:15px;display:block}#ra-{{ section.id }} .ra-play{display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.45);color:#fff;border:2px solid #fff;border-radius:50%;width:64px;height:64px;padding:0}#ra-{{ section.id }} .ra-play svg{width:32px;height:32px;display:block}</style></section>
{% schema %}{"name":"Ra Biker grooming","settings":[{"type":"product","id":"product","label":"Grooming product"},{"type":"image_picker","id":"hero","label":"Hero lifestyle image"},{"type":"text","id":"heading","label":"Headline","default":"Brush your dog at home. Keep the fur out of your house."},{"type":"textarea","id":"description","label":"Description","default":"Brush, de-shed, and trim your dog while a built-in vacuum collects loose hair as you work."},{"type":"video","id":"demo","label":"Demonstration video"},{"type":"image_picker","id":"poster","label":"Video poster"},{"type":"text","id":"rating","label":"Confirmed manufacturer rating"},{"type":"text","id":"review_count","label":"Confirmed review count"},{"type":"url","id":"review_link","label":"Manufacturer review source"},{"type":"image_picker","id":"step1","label":"Brush — select image"},{"type":"image_picker","id":"step2","label":"Collect — select image"},{"type":"image_picker","id":"step3","label":"Empty — select image"},{"type":"image_picker","id":"kit1","label":"Accessory 1 image"},{"type":"image_picker","id":"kit2","label":"Accessory 2 image"},{"type":"image_picker","id":"kit3","label":"Accessory 3 image"},{"type":"image_picker","id":"kit4","label":"Accessory 4 image"},{"type":"image_picker","id":"kit5","label":"Accessory 5 image"},{"type":"text","id":"benefit1","label":"Benefit 1","default":"Cleaner Home"},{"type":"text","id":"benefit2","label":"Benefit 2","default":"Groom at Home"},{"type":"text","id":"benefit3","label":"Benefit 3","default":"Collect Loose Fur"},{"type":"text","id":"benefit4","label":"Benefit 4","default":"Easy to Use"},{"type":"header","content":"Lower page — benefits and FAQ"},{"type":"image_picker","id":"lower_benefit_image","label":"Dog and vacuum benefits photo"},{"type":"image_picker","id":"lower_banner_image","label":"Final banner photo"},{"type":"text","id":"lower_benefit0","label":"Benefit 1","default":"Helps collect loose fur"},{"type":"text","id":"lower_benefit1","label":"Benefit 2","default":"Keeps your home cleaner"},{"type":"text","id":"lower_benefit2","label":"Benefit 3","default":"Groom at your dog's pace"},{"type":"text","id":"lower_benefit3","label":"Benefit 4","default":"Easy to clean and maintain"},{"type":"text","id":"lower_benefit4","label":"Benefit 5","default":"Multiple grooming attachments"},{"type":"text","id":"faq_q0","label":"FAQ 1 question","default":"Will it scare my dog?"},{"type":"textarea","id":"faq_a0","label":"FAQ 1 answer","default":"Every dog reacts differently. Introduce the switched-off unit first, then gradually introduce the sound. Stop if your dog becomes distressed."},{"type":"text","id":"faq_q1","label":"FAQ 2 question","default":"Is it good for large dogs?"},{"type":"textarea","id":"faq_a1","label":"FAQ 2 answer","default":"Check the product specifications and attachment suitability for your dog's size before use."},{"type":"text","id":"faq_q2","label":"FAQ 3 question","default":"Can I use it on long-haired dogs?"},{"type":"textarea","id":"faq_a2","label":"FAQ 3 answer","default":"Choose an attachment suitable for your dog's coat and follow the manufacturer's instructions. Do not pull through tangled fur."},{"type":"text","id":"faq_q3","label":"FAQ 4 question","default":"How do I clean the vacuum?"},{"type":"textarea","id":"faq_a3","label":"FAQ 4 answer","default":"Switch off and unplug the unit before emptying the container. Follow the manufacturer's filter and cleaning instructions."},{"type":"text","id":"faq_q4","label":"FAQ 5 question","default":"What's included in the box?"},{"type":"textarea","id":"faq_a4","label":"FAQ 5 answer","default":"Check the kit contents listed above and the confirmed product specifications."},{"type":"text","id":"lower_heading","label":"Final banner heading","default":"Give Your Dog a Cleaner, More Comfortable Grooming Experience"},{"type":"textarea","id":"lower_copy","label":"Final banner description","default":"A simple way to groom at home and collect loose fur."}],"presets":[{"name":"Ra Biker grooming"}]}{% endschema %}