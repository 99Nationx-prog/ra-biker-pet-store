<section class="store-faq page-width" aria-labelledby="StoreFaqHeading"><div class="store-faq__intro"><p class="eyebrow">GOOD TO KNOW</p><h2 id="StoreFaqHeading">{{ section.settings.heading | escape }}</h2><p>Everything you need to feel ready before checkout.</p><a href="/pages/contact">Need more help? Contact us →</a></div><div class="store-faq__questions">
{% for block in section.blocks %}<details class="store-faq__item" {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}<span aria-hidden="true">+</span></summary><div class="rte">{{ block.settings.answer }}</div></details>{% endfor %}
</div></section>
{% schema %}{"name":"Shopping FAQ","settings":[{"type":"text","id":"heading","label":"Heading","default":"A little help before you shop"}],"blocks":[{"type":"question","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"Where can I find delivery information?"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>Shipping options and any applicable charges are shown during checkout. Please review them before placing your order.</p>"}]}],"presets":[{"name":"Shopping FAQ","blocks":[{"type":"question","settings":{"question":"How much is shipping?","answer":"<p>Available shipping methods and charges are calculated at checkout based on your address and order.</p>"}},{"type":"question","settings":{"question":"Can I return an item?","answer":"<p>Please review our returns policy linked in the footer before purchasing.</p>"}},{"type":"question","settings":{"question":"How can I get help?","answer":"<p>Use our Contact page to send us a question about a product or order.</p>"}}]}]}{% endschema %}