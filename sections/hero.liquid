<section class="hero hero--integrated"><div class="hero-inner page-width">
  <div class="hero-copy">
    <p class="eyebrow">A LITTLE MORE JOY, EVERY DAY</p>
    <h1>{{ section.settings.heading | escape }}</h1>
    <p class="hero-description">{{ section.settings.subheading | escape }}</p>
    <div class="hero-buttons"><a class="button primary" href="{{ section.settings.dog_link | default: collections['dogs'].url | default: routes.all_products_collection_url }}">{{ section.settings.dog_label | escape }} →</a><a class="button outline" href="{{ section.settings.cat_link | default: collections['cats'].url | default: routes.all_products_collection_url }}">{{ section.settings.cat_label | escape }} →</a></div>
  </div>
  <div class="hero-photo">
    {% if section.settings.hero_image != blank %}
      <picture>
        {% if section.settings.mobile_hero_image != blank %}
          <source media="(max-width: 900px)" srcset="{{ section.settings.mobile_hero_image | image_url: width: 600 }} 600w, {{ section.settings.mobile_hero_image | image_url: width: 900 }} 900w, {{ section.settings.mobile_hero_image | image_url: width: 1200 }} 1200w" sizes="100vw">
        {% endif %}
        {{ section.settings.hero_image | image_url: width: 2000 | image_tag: loading: 'eager', widths: '600, 900, 1200, 1600, 2000', sizes: '100vw', alt: 'Dog and cat relaxing together' }}
      </picture>
    {% else %}
      <div class="image-placeholder" role="img" aria-label="Pet lifestyle image coming soon"><span>Made for their happiest days.</span><small>Discover everyday favorites for dogs and cats.</small></div>
    {% endif %}
  </div>
</div></section>
{% schema %}
{
  "name": "Dog and cat hero",
  "settings": [
    {"type":"image_picker","id":"hero_image","label":"Desktop hero dog and cat image"},
    {"type":"image_picker","id":"mobile_hero_image","label":"Mobile hero image (optional)"},
    {"type":"text","id":"heading","label":"Headline","default":"Better days for dogs & cats."},
    {"type":"text","id":"subheading","label":"Supporting text","default":"Thoughtfully chosen essentials for the companions we love."},
    {"type":"text","id":"dog_label","label":"Dog button","default":"Shop Dogs"},
    {"type":"url","id":"dog_link","label":"Dog collection link"},
    {"type":"text","id":"cat_label","label":"Cat button","default":"Shop Cats"},
    {"type":"url","id":"cat_link","label":"Cat collection link"}
  ],
  "presets":[{"name":"Dog and cat hero"}]
}
{% endschema %}