<section class="hero"><div class="hero-inner page-width"><div class="hero-copy"><p class="eyebrow">A LITTLE MORE JOY, EVERY DAY</p><h1>{{ section.settings.heading | escape }}</h1><p class="hero-description">{{ section.settings.subheading | escape }}</p><div class="hero-buttons"><a class="button primary" href="{{ section.settings.dog_link | default: '/collections/dogs' }}">{{ section.settings.dog_label | escape }} →</a><a class="button outline" href="{{ section.settings.cat_link | default: '/collections/cats' }}">{{ section.settings.cat_label | escape }} →</a></div></div><div class="hero-photo">{% if section.settings.hero_image != blank %}{{ section.settings.hero_image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '400, 700, 1000, 1400', alt: 'Dog and cat relaxing together' }}{% else %}<div class="image-placeholder"><span>Dog + cat lifestyle photography</span><small>Upload the approved hero photo in the theme editor</small></div>{% endif %}</div></div></section>
{% schema %}{"name":"Dog and cat hero","settings":[{"type":"image_picker","id":"hero_image","label":"Hero dog and cat image"},{"type":"text","id":"heading","label":"Headline","default":"Better days for dogs & cats."},{"type":"text","id":"subheading","label":"Supporting text","default":"Thoughtfully chosen essentials for the companions we love."},{"type":"text","id":"dog_label","label":"Dog button","default":"Shop Dogs"},{"type":"url","id":"dog_link","label":"Dog collection link"},{"type":"text","id":"cat_label","label":"Cat button","default":"Shop Cats"},{"type":"url","id":"cat_link","label":"Cat collection link"}],"presets":[{"name":"Dog and cat hero"}]} {% endschema %}