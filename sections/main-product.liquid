<section class="page-width product-detail"><div>{% if product.featured_image %}{{ product.featured_image | image_url: width: 1000 | image_tag: loading: 'eager' }}{% endif %}</div><div><p class="eyebrow">RA BIKER PET STORE</p><h1>{{ product.title | escape }}</h1><p class="price">{{ product.price | money }}</p><div class="rte">{{ product.description }}</div>{% form 'product', product %}<label for="variant">Choose an option</label><select name="id" id="variant">{% for variant in product.variants %}<option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}</select><button class="button primary" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to bag{% else %}Sold out{% endif %}</button>{% endform %}</div></section>
{% schema %}{"name":"Product details","settings":[]} {% endschema %}