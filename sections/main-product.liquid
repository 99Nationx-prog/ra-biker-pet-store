<section class="page-width product-detail product-detail--premium">
<div class="product-detail__gallery">{% if product.featured_image %}<div class="product-detail__main-image">{{ product.featured_image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '480, 720, 1000, 1400' }}</div>{% endif %}{% if product.images.size > 1 %}<div class="product-detail__thumbs">{% for image in product.images limit: 6 %}<a href="{{ image | image_url: width: 1600 }}" target="_blank" rel="noopener" aria-label="View larger product photo {{ forloop.index }}">{{ image | image_url: width: 220 | image_tag: loading: 'lazy' }}</a>{% endfor %}</div>{% endif %}</div>
<div class="product-detail__info"><p class="eyebrow">A LITTLE SOMETHING THEY'LL LOVE</p><h1>{{ product.title | escape }}</h1><p class="price">{{ product.price | money }}{% if product.compare_at_price > product.price %} <s class="old-price">{{ product.compare_at_price | money }}</s>{% endif %}</p><p class="stock-message">{% if product.available %}● In stock — ready to order{% else %}Currently sold out{% endif %}</p>
{% form 'product', product %}<label for="ProductVariant-{{ section.id }}">Choose your option</label><select name="id" id="ProductVariant-{{ section.id }}" required>{% for variant in product.variants %}<option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}</select><label for="ProductQuantity-{{ section.id }}">Quantity</label><input id="ProductQuantity-{{ section.id }}" class="product-quantity" type="number" name="quantity" min="1" value="1" inputmode="numeric"><button class="button primary product-detail__buy" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to bag →{% else %}Sold out{% endif %}</button>{% endform %}
<div class="product-assurance"><p>🔒 Secure checkout powered by Shopify</p><p>🚚 Delivery costs and options shown at checkout</p><p>↩ <a href="/policies/refund-policy">Read returns & refunds policy</a></p></div>
<details class="product-detail__accordion" open><summary>Product details</summary><div class="rte">{{ product.description }}</div></details><details class="product-detail__accordion"><summary>Shipping & returns</summary><p>Shipping options and charges depend on your delivery address and appear at checkout. Please review our <a href="/policies/shipping-policy">shipping policy</a> and <a href="/policies/refund-policy">returns policy</a> before ordering.</p></details><details class="product-detail__accordion"><summary>Need a hand?</summary><p>Questions about sizing, compatibility, or your order? <a href="/pages/contact">Contact our team</a>.</p></details>
</div></section>
{% schema %}{"name":"Product details","settings":[]} {% endschema %}