<section class="page-width product-detail"><div>{% if product.featured_image %}{{ product.featured_image | image_url: width: 1000 | image_tag: loading: 'eager' }}{% endif %}</div><div><p class="eyebrow">RA BIKER PET STORE</p><h1>{{ product.title | escape }}</h1><p class="price">{{ product.price | money }}{% if product.compare_at_price > product.price %} <s class="old-price">{{ product.compare_at_price | money }}</s>{% endif %}</p>{% if product.available %}<p class="stock-message">Available to order</p>{% endif %}<div class="rte">{{ product.description }}</div>{% form 'product', product %}<label for="variant">Choose an option</label><select name="id" id="variant">{% for variant in product.variants %}<option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}</select><label for="ProductQuantity">Quantity</label><input id="ProductQuantity" class="product-quantity" type="number" name="quantity" min="1" value="1" inputmode="numeric"><button class="button primary" type="submit" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to bag{% else %}Sold out{% endif %}</button>{% endform %}<div class="product-assurance"><p>✓ Secure checkout through Shopify</p><p>✓ Shipping options calculated at checkout</p><p>✓ <a href="/policies/refund-policy">Review our returns policy</a></p><p>Questions? <a href="/pages/contact">Contact us</a></p></div></div></section>
{% schema %}{"name":"Product details","settings":[]} {% endschema %}