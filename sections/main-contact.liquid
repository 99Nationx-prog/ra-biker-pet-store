<section class="page-width contact-page"><p class="eyebrow">WE'RE HERE TO HELP</p><h1>{{ page.title | default: 'Contact us' | escape }}</h1><p>Have a question about a product or an order? Send us a message and we'll get back to you.</p>{% form 'contact', id: 'ContactForm' %}{% if form.posted_successfully? %}<p role="status">Thank you. Your message has been sent.</p>{% endif %}{{ form.errors | default_errors }}<div class="contact-page__fields"><label for="ContactName">Your name</label><input id="ContactName" type="text" name="contact[name]" value="{{ form.name | escape }}" autocomplete="name" required><label for="ContactEmail">Email address</label><input id="ContactEmail" type="email" name="contact[email]" value="{{ form.email | escape }}" autocomplete="email" required><label for="ContactPhone">Phone (optional)</label><input id="ContactPhone" type="tel" name="contact[phone]" autocomplete="tel"><label for="ContactMessage">How can we help?</label><textarea id="ContactMessage" name="contact[body]" rows="6" required>{{ form.body | escape }}</textarea><button class="button primary" type="submit">Send message</button></div>{% endform %}</section>{% schema %}{"name":"Contact form","settings":[]} {% endschema %}