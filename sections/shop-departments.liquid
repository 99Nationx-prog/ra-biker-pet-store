<section class="shop-departments page-width" aria-labelledby="ShopDepartmentsTitle"><div class="section-heading"><div>{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}<h2 id="ShopDepartmentsTitle">{{ section.settings.heading | escape }}</h2><p class="shop-departments__lead">{{ section.settings.description | escape }}</p></div>{% if section.settings.button_label != blank %}<a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} →</a>{% endif %}</div><div class="shop-departments__grid">{% for block in section.blocks %}{% assign department = block.settings.collection %}<a class="shop-department shop-department--{{ forloop.index }}" href="{{ block.settings.link | default: department.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}><div class="shop-department__photo">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '320, 480, 800' }}{% elsif department != blank and department.featured_image != blank %}{{ department.featured_image | image_url: width: 800 | image_tag: loading: 'lazy' }}{% else %}<span class="shop-department__symbol" aria-hidden="true">{{ block.settings.emoji | escape }}</span>{% endif %}</div><div class="shop-department__copy"><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.description | escape }}</p><span>{{ block.settings.button_label | escape }} <span aria-hidden="true">↗</span></span></div></a>{% endfor %}</div></section>
{% schema %}{"name":"Shop departments","settings":[{"type":"text","id":"eyebrow","label":"Small heading","default":"THE RA BIKER EDIT"},{"type":"text","id":"heading","label":"Main heading","default":"Their favorites, all in one happy place."},{"type":"textarea","id":"description","label":"Description","default":"From delicious dinners to the next favorite toy, discover the little things that make tails wag and whiskers twitch."},{"type":"text","id":"button_label","label":"Top button text","default":"Shop everything"},{"type":"url","id":"button_link","label":"Top button link"}],"blocks":[{"type":"department","name":"Department card","settings":[{"type":"text","id":"title","label":"Card heading","default":"Pet essentials"},{"type":"textarea","id":"description","label":"Card description","default":"Discover something they'll love."},{"type":"image_picker","id":"image","label":"Card photo (optional)"},{"type":"collection","id":"collection","label":"Collection (also provides photo fallback)"},{"type":"url","id":"link","label":"Custom card link (optional)"},{"type":"text","id":"emoji","label":"Icon if no photo","default":"🐾"},{"type":"text","id":"button_label","label":"Button text","default":"Shop now"}]}],"max_blocks":12,"presets":[{"name":"Shop departments","blocks":[{"type":"department"},{"type":"department"},{"type":"department"}]}]}{% endschema %}