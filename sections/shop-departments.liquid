<section class="shop-departments page-width" aria-labelledby="ShopDepartmentsTitle">
<div class="section-heading"><div><p class="eyebrow">THE RA BIKER EDIT</p><h2 id="ShopDepartmentsTitle">Their favorites, all in one happy place.</h2><p class="shop-departments__lead">From delicious dinners to the next favorite toy, discover the little things that make tails wag and whiskers twitch.</p></div><a href="{{ routes.all_products_collection_url }}">Shop everything →</a></div>
<div class="shop-departments__grid">
{% assign titles = 'Dog Food & Treats|Cat Food & Treats|Toys & Playtime|Beds & Comfort|Bowls & Feeding|Grooming & Care' | split: '|' %}
{% assign descriptions = 'Everyday meals and rewarding little bites.|Good food for the fussiest little food critics.|Fetch it. Chase it. Love it. Repeat.|Their new favorite place to snooze.|Make every mealtime feel special.|A little extra care for their best days.' | split: '|' %}
{% assign emojis = '🥣|🐟|🎾|🛏️|💧|🧼' | split: '|' %}
{% assign handles = 'dog-food|cat-food|pet-toys|pet-beds|feeding-accessories|pet-grooming' | split: '|' %}
{% for title in titles %}{% assign handle = handles[forloop.index0] %}{% assign department = collections[handle] %}<a class="shop-department shop-department--{{ forloop.index }}" href="{% if department != blank %}{{ department.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">
<div class="shop-department__photo">{% if department != blank and department.featured_image != blank %}{{ department.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '320, 480, 800' }}{% else %}{% case forloop.index %}{% when 1 %}{% assign fallback = section.settings.dog_food_image %}{% when 2 %}{% assign fallback = section.settings.cat_food_image %}{% when 3 %}{% assign fallback = section.settings.toys_image %}{% when 4 %}{% assign fallback = section.settings.beds_image %}{% when 5 %}{% assign fallback = section.settings.feeding_image %}{% when 6 %}{% assign fallback = section.settings.grooming_image %}{% endcase %}{% if fallback != blank %}{{ fallback | image_url: width: 800 | image_tag: loading: 'lazy', widths: '320, 480, 800' }}{% else %}<span class="shop-department__symbol" aria-hidden="true">{{ emojis[forloop.index0] }}</span>{% endif %}{% endif %}</div>
<div class="shop-department__copy"><h3>{{ title }}</h3><p>{{ descriptions[forloop.index0] }}</p><span>Shop now <span aria-hidden="true">↗</span></span></div></a>{% endfor %}
</div></section>
{% schema %}{"name":"Shop departments","settings":[{"type":"image_picker","id":"dog_food_image","label":"Dog food photo"},{"type":"image_picker","id":"cat_food_image","label":"Cat food photo"},{"type":"image_picker","id":"toys_image","label":"Toys photo"},{"type":"image_picker","id":"beds_image","label":"Beds photo"},{"type":"image_picker","id":"feeding_image","label":"Feeding photo"},{"type":"image_picker","id":"grooming_image","label":"Grooming photo"}],"presets":[{"name":"Shop departments"}]}{% endschema %}