<section class="shop-departments page-width" aria-labelledby="ShopDepartmentsTitle"><div class="section-heading"><div><p class="eyebrow">EVERYTHING FOR THEIR EVERYDAY</p><h2 id="ShopDepartmentsTitle">Find what makes their tails wag.</h2><p class="shop-departments__lead">From the food bowl to the toy basket, explore essentials for every moment with your dog or cat.</p></div><a href="{{ routes.all_products_collection_url }}">Shop all products →</a></div><div class="shop-departments__grid">
{% assign dog_food = collections['dog-food'] %}{% assign cat_food = collections['cat-food'] %}{% assign toys = collections['pet-toys'] %}{% assign beds = collections['pet-beds'] %}{% assign feeding = collections['feeding-accessories'] %}{% assign grooming = collections['pet-grooming'] %}
{% assign titles = 'Dog Food & Treats|Cat Food & Treats|Toys & Playtime|Beds & Comfort|Bowls & Feeding|Grooming & Care' | split: '|' %}
{% assign descriptions = 'Mealtime favorites, snacks and rewards for good dogs.|Explore food and treats for curious, hungry cats.|Fetch, chase, pounce and play all day.|Soft spots for naps, rest and sweet dreams.|Bowls, mats and accessories for everyday meals.|Brushes and care essentials for feeling their best.' | split: '|' %}
{% assign emojis = '🥣|🐟|🎾|🛏️|💧|🧼' | split: '|' %}
{% assign handles = 'dog-food|cat-food|pet-toys|pet-beds|feeding-accessories|pet-grooming' | split: '|' %}
{% for title in titles %}{% assign handle = handles[forloop.index0] %}{% assign department = collections[handle] %}<a class="shop-department" href="{% if department != blank %}{{ department.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"><div class="shop-department__photo">{% if department != blank and department.featured_image != blank %}{{ department.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '320, 480, 700' }}{% else %}<span aria-hidden="true">{{ emojis[forloop.index0] }}</span>{% endif %}</div><div class="shop-department__copy"><h3>{{ title }}</h3><p>{{ descriptions[forloop.index0] }}</p><span>Explore collection <span aria-hidden="true">→</span></span></div></a>{% endfor %}
</div></section>
{% schema %}{"name":"Shop departments","settings":[],"presets":[{"name":"Shop departments"}]}{% endschema %}