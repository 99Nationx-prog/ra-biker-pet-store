<section class="featured page-width"><div class="section-heading"><div><p class="eyebrow">THE GOOD STUFF</p><h2>{{ section.settings.heading | escape }}</h2></div><a href="{{ section.settings.collection.url | default: '/collections/all' }}">Shop all →</a></div><div class="product-grid">{% assign featured_collection = section.settings.collection %}{% for product in featured_collection.products limit: 4 %}<a class="product-card" href="{{ product.url }}"><div class="product-photo">{% if product.featured_image %}{{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy' }}{% endif %}</div><h3>{{ product.title | escape }}</h3><p>{{ product.price | money }}</p></a>{% else %}<p class="empty-message">Select a collection in the theme editor to show your products here.</p>{% endfor %}</div></section>
{% schema %}{"name":"Featured products","settings":[{"type":"text","id":"heading","label":"Heading","default":"Everyday favorites"},{"type":"collection","id":"collection","label":"Collection"}],"presets":[{"name":"Featured products"}]} {% endschema %}