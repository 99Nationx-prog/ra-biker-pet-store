<section class="featured page-width"><div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><a href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} →</a></div>
<div class="product-grid">{% assign featured_collection = section.settings.collection %}{% if featured_collection == blank %}{% assign featured_collection = collections['all'] %}{% endif %}{% for product in featured_collection.products limit: 4 %}
<a class="product-card" href="{{ product.url }}"><div class="product-photo">{% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy' }}{% endif %}</div><h3>{{ product.title | escape }}</h3><p>{{ product.price | money }}{% if product.compare_at_price > product.price %} <s>{{ product.compare_at_price | money }}</s>{% endif %}</p></a>
{% else %}<p class="empty-message">Products will appear here as soon as they are added to your store.</p>{% endfor %}</div></section>
{% schema %}{"name":"Featured products","settings":[{"type":"text","id":"eyebrow","label":"Small heading","default":"THE GOOD STUFF"},{"type":"text","id":"button_label","label":"View all button text","default":"View all"},{"type":"text","id":"heading","label":"Heading","default":"Everyday favorites"},{"type":"collection","id":"collection","label":"Collection"}],"presets":[{"name":"Featured products"}]} {% endschema %}