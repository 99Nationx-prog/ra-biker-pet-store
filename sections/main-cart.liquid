<section class="page-width cart-page"><h1>Your bag</h1>{% if cart.item_count == 0 %}<p>Your bag is empty.</p><a class="button primary" href="/collections/all">Explore products</a>{% else %}<form action="{{ routes.cart_url }}" method="post">{% for item in cart.items %}<div class="cart-line"><div><a href="{{ item.url }}">{{ item.product.title | escape }}</a><p>{{ item.variant.title | escape }} · {{ item.final_line_price | money }}</p></div><label>Quantity <input type="number" name="updates[]" value="{{ item.quantity }}" min="0"></label></div>{% endfor %}<p class="cart-total">Subtotal: {{ cart.total_price | money }}</p><button type="submit" name="update" class="button outline">Update bag</button><button type="submit" name="checkout" class="button primary">Checkout</button></form>{% endif %}</section>
{% schema %}{"name":"Shopping cart","settings":[]} {% endschema %}