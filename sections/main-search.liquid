<section class="page-width search-page"><p class="eyebrow">FIND THEIR FAVORITES</p><h1>Search our store</h1><form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form"><label for="StoreSearch">What are you looking for?</label><div class="search-page__controls"><input id="StoreSearch" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Try toys, beds or grooming" required><input type="hidden" name="type" value="product"><button class="button primary" type="submit">Search</button></div></form>{% if search.performed %}<p aria-live="polite">{{ search.results_count }} results for “{{ search.terms | escape }}”</p>{% paginate search.results by 24 %}<div class="product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}<a class="product-card" href="{{ item.url }}"><div class="product-photo">{% if item.featured_image != blank %}{{ item.featured_image | image_url: width: 650 | image_tag: loading: 'lazy' }}{% endif %}</div><h2>{{ item.title | escape }}</h2><p>{{ item.price | money }}</p><span>View product →</span></a>{% endif %}{% else %}<p>No matches yet. Try another search or <a href="{{ routes.all_products_collection_url }}">browse all products</a>.</p>{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}{% endif %}</section>
{% schema %}{"name":"Search results","settings":[]} {% endschema %}