{% if section.blocks.size > 0 %}<section class="pet-clips page-width" aria-labelledby="PetClipsHeading"><div class="section-heading"><div><p class="eyebrow">IN REAL LIFE</p><h2 id="PetClipsHeading">{{ section.settings.heading | escape }}</h2><p>{{ section.settings.description | escape }}</p></div><a href="{{ routes.all_products_collection_url }}">Shop their favorites →</a></div><div class="pet-clips__grid">{% for block in section.blocks %}<article class="pet-clip" {{ block.shopify_attributes }}><div class="pet-clip__visual">{% if block.settings.video != blank %}{{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: true, playsinline: true, image_size: '600x' }}{% elsif block.settings.poster != blank %}{{ block.settings.poster | image_url: width: 800 | image_tag: loading: 'lazy' }}{% else %}<div class="pet-clip__empty">Add your pet video in the theme editor</div>{% endif %}</div><div class="pet-clip__text"><h3>{{ block.settings.title | escape }}</h3>{% if block.settings.product != blank %}<a href="{{ block.settings.product.url }}">{{ block.settings.product.title | escape }} · {{ block.settings.product.price | money }} →</a>{% elsif block.settings.link != blank %}<a href="{{ block.settings.link }}">Explore more →</a>{% endif %}</div></article>{% endfor %}</div></section>{% endif %}
{% schema %}{"name":"Pet video showcase","settings":[{"type":"text","id":"heading","label":"Heading","default":"See their happy moments"},{"type":"text","id":"description","label":"Description","default":"Watch our products in everyday pet life."}],"blocks":[{"type":"clip","name":"Short pet video","settings":[{"type":"video","id":"video","label":"Upload a short video"},{"type":"image_picker","id":"poster","label":"Photo fallback"},{"type":"text","id":"title","label":"Caption","default":"A little moment of joy"},{"type":"product","id":"product","label":"Featured product"},{"type":"url","id":"link","label":"Optional link"}]}],"max_blocks":8,"presets":[{"name":"Pet video showcase"}]}{% endschema %}