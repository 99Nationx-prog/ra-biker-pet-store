<section class="pet-video-showcase page-width" aria-labelledby="PetVideoTitle"><div class="section-heading"><div><p class="eyebrow">SEE THE HAPPY MOMENTS</p><h2 id="PetVideoTitle">{{ section.settings.heading | escape }}</h2><p>{{ section.settings.description | escape }}</p></div><a href="{{ routes.all_products_collection_url }}">Explore the shop →</a></div><div class="pet-video-showcase__grid">{% for block in section.blocks %}<article class="pet-video-tile" {{ block.shopify_attributes }}><div class="pet-video-tile__media">{% if block.settings.video != blank %}{{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: true, playsinline: true, image_size: '700x' }}{% elsif block.settings.image != blank %}{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy' }}{% else %}<div class="pet-video-tile__placeholder"><span aria-hidden="true">▶</span><p>Add a 3–10 second pet video in the theme editor</p></div>{% endif %}</div><div class="pet-video-tile__caption"><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.caption | escape }}</p>{% if block.settings.link != blank %}<a href="{{ block.settings.link }}">Shop the moment →</a>{% endif %}</div></article>{% endfor %}</div></section>
{% schema %}{"name":"Pet video moments","settings":[{"type":"text","id":"heading","label":"Heading","default":"Real pets. Little moments of joy."},{"type":"text","id":"description","label":"Description","default":"Watch playful moments, grooming routines and favorite finds in action."}],"blocks":[{"type":"clip","name":"Video or photo","settings":[{"type":"video","id":"video","label":"Upload short video"},{"type":"image_picker","id":"image","label":"Fallback photo"},{"type":"text","id":"title","label":"Title","default":"A moment worth sharing"},{"type":"text","id":"caption","label":"Caption","default":"A little everyday happiness."},{"type":"url","id":"link","label":"Related collection or product"}]}],"max_blocks":8,"presets":[{"name":"Pet video moments","blocks":[{"type":"clip","settings":{"title":"Playtime favorites","caption":"Watch the fun unfold."}},{"type":"clip","settings":{"title":"Grooming made simple","caption":"Fresh looks and happy tails."}},{"type":"clip","settings":{"title":"Mealtime moments","caption":"Discover feeding essentials."}}]}]}{% endschema %}