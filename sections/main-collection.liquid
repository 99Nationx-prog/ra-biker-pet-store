<section class="page-width collection-page collection-page--premium"><p class="eyebrow">THE RA BIKER COLLECTION</p><h1>{{ collection.title | escape }}</h1>{% if collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% endif %}
{% paginate collection.products by 24 %}
<div class="collection-toolbar"><span>{{ collection.products_count }} products</span><form method="get" action="{{ collection.url }}"><label for="SortBy-{{ section.id }}">Sort by</label><select id="SortBy-{{ section.id }}" name="sort_by" onchange="this.form.submit()">{% assign current_sort = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value | escape }}" {% if option.value == current_sort %}selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}</select><noscript><button type="submit">Apply</button></noscript></form></div>
<div class="collection-layout">{% if collection.filters.size > 0 %}<aside class="collection-filters"><details open><summary>Filter products</summary><form method="get" action="{{ collection.url }}"><input type="hidden" name="sort_by" value="{{ current_sort | escape }}">{% for filter in collection.filters %}<details class="collection-filter"><summary>{{ filter.label | escape }}</summary>{% case filter.type %}{% when 'list' %}{% for value in filter.values %}<label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}> {{ value.label | escape }} ({{ value.count }})</label>{% endfor %}{% when 'price_range' %}<label>Minimum <input type="number" min="0" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}" placeholder="Min"></label><label>Maximum <input type="number" min="0" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}" placeholder="Max"></label>{% endcase %}</details>{% endfor %}<button class="button primary" type="submit">Apply filters</button><a class="collection-clear" href="{{ collection.url }}">Clear filters</a></form></details></aside>{% endif %}
<div class="product-grid">{% for product in collection.products %}<a class="product-card" href="{{ product.url }}"><div class="product-photo">{% if product.featured_image %}{{ product.featured_image | image_url: width: 650 | image_tag: loading: 'lazy', widths: '240, 420, 650' }}{% else %}<span class="product-placeholder">Product photo coming soon</span>{% endif %}</div><h2>{{ product.title | escape }}</h2><p>{{ product.price | money }}{% if product.compare_at_price > product.price %} <s>{{ product.compare_at_price | money }}</s>{% endif %}</p><span class="product-card__cta">View details →</span></a>{% else %}<p class="empty-message">No products match your selection. Try removing a filter or exploring our other collections.</p>{% endfor %}</div></div>{{ paginate | default_pagination }}{% endpaginate %}</section>
{% schema %}{"name":"Collection products","settings":[]} {% endschema %}