<section class="store-spotlight page-width"><div class="store-spotlight__content">{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}<h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.description | escape }}</p>{% if section.settings.button_label != blank %}<a class="button primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} →</a>{% endif %}</div><div class="store-spotlight__image">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 700, 1000, 1200', sizes: '(max-width: 700px) 100vw, 50vw' }}{% else %}<div class="store-spotlight__placeholder" aria-hidden="true">♡</div>{% endif %}</div></section>
{% schema %}{"name":"Lifestyle spotlight","settings":[{"type":"text","id":"eyebrow","label":"Small heading","default":"LITTLE THINGS. BIG TAIL WAGS."},{"type":"text","id":"heading","label":"Heading","default":"Everyday joy starts here."},{"type":"textarea","id":"description","label":"Description","default":"From cozy corners to playful afternoons, discover the little essentials that make life with your companion even better."},{"type":"text","id":"button_label","label":"Button text","default":"Explore all essentials"},{"type":"url","id":"button_link","label":"Button link"},{"type":"image_picker","id":"image","label":"Lifestyle image"}],"presets":[{"name":"Lifestyle spotlight"}]}{% endschema %}