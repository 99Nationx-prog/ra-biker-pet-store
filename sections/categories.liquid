<section class="categories page-width" aria-label="Shop by pet">
{% assign category_titles = 'For Dogs|For Cats|Everyday Essentials' | split: '|' %}
<a class="category-card" href="/collections/dogs"><div class="category-photo">{% if section.settings.dog_image != blank %}{{ section.settings.dog_image | image_url: width: 850 | image_tag: loading: 'lazy' }}{% endif %}</div><div class="category-copy"><h2>For Dogs</h2><p>Walks, playtime and everything in between.</p><span aria-hidden="true">→</span></div></a>
<a class="category-card" href="/collections/cats"><div class="category-photo">{% if section.settings.cat_image != blank %}{{ section.settings.cat_image | image_url: width: 850 | image_tag: loading: 'lazy' }}{% endif %}</div><div class="category-copy"><h2>For Cats</h2><p>Cozy corners, curious minds, happy cats.</p><span aria-hidden="true">→</span></div></a>
<a class="category-card" href="{{ routes.all_products_collection_url }}"><div class="category-photo">{% if section.settings.essentials_image != blank %}{{ section.settings.essentials_image | image_url: width: 850 | image_tag: loading: 'lazy' }}{% endif %}</div><div class="category-copy"><h2>Everyday Essentials</h2><p>Simple things that make their day.</p><span aria-hidden="true">→</span></div></a>
</section>
{% schema %}{"name":"Shop by pet","settings":[{"type":"image_picker","id":"dog_image","label":"Dog category image"},{"type":"image_picker","id":"cat_image","label":"Cat category image"},{"type":"image_picker","id":"essentials_image","label":"Essentials category image"}],"presets":[{"name":"Shop by pet"}]} {% endschema %}