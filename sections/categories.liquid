<section class="categories-section page-width" aria-label="{{ section.settings.heading | default: 'Shop by pet' | escape }}">{% if section.settings.heading != blank %}<div class="categories-section__heading"><h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.description != blank %}<p>{{ section.settings.description | escape }}</p>{% endif %}</div>{% endif %}<div class="categories categories--visual categories--editable{% if section.settings.mobile_scroll %} categories--scroll{% endif %}">{% for block in section.blocks %}{% assign selected_collection = block.settings.collection %}<a class="category-card" href="{{ block.settings.link | default: selected_collection.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}><div class="category-photo">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'category-image' }}{% elsif selected_collection.featured_image != blank %}{{ selected_collection.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'category-image' }}{% endif %}</div><div class="category-copy"><h2>{{ block.settings.title | escape }}</h2><p>{{ block.settings.description | escape }}</p>{% if block.settings.button_label != blank %}<span class="category-arrow">{{ block.settings.button_label | escape }} →</span>{% endif %}</div></a>{% endfor %}</div></section>
{% schema %}{"name":"Shop by pet","settings":[{"type":"text","id":"heading","label":"Section heading","default":"Shop by pet"},{"type":"textarea","id":"description","label":"Section description"},{"type":"checkbox","id":"mobile_scroll","label":"Swipe cards sideways on mobile","default":true}],"blocks":[{"type":"category","name":"Shopping category","settings":[{"type":"text","id":"title","label":"Card title","default":"Shop pets"},{"type":"textarea","id":"description","label":"Card description","default":"Discover something wonderful."},{"type":"image_picker","id":"image","label":"Card photo"},{"type":"collection","id":"collection","label":"Linked collection"},{"type":"url","id":"link","label":"Custom link (optional)"},{"type":"text","id":"button_label","label":"Button text","default":"Shop now"}]}],"max_blocks":12,"presets":[{"name":"Shop by pet","blocks":[{"type":"category"},{"type":"category"},{"type":"category"}]}]}{% endschema %}