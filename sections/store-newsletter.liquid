<section class="store-newsletter"><div class="page-width store-newsletter__inner"><div><p class="eyebrow">THE RA BIKER CLUB</p><h2>More happy moments, straight to your inbox.</h2><p>Sign up for pet care inspiration, new arrivals and store news. Unsubscribe any time.</p></div><div>{% form 'customer', class: 'store-newsletter__form' %}<input type="hidden" name="contact[tags]" value="newsletter">{% if form.posted_successfully? %}<p role="status">Thanks for subscribing!</p>{% else %}<label for="NewsletterEmail">Your email address</label><div class="store-newsletter__fields"><input id="NewsletterEmail" type="email" name="contact[email]" placeholder="you@example.com" autocomplete="email" required><button type="submit">Join the club →</button></div>{% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}{% endif %}{% endform %}</div></div></section>
{% schema %}{"name":"Newsletter signup","settings":[],"presets":[{"name":"Newsletter signup"}]}{% endschema %}