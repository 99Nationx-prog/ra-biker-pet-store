<section class="store-newsletter"><div class="page-width store-newsletter__inner"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.description | escape }}</p></div><div>{% form 'customer', class: 'store-newsletter__form' %}<input type="hidden" name="contact[tags]" value="newsletter">{% if form.posted_successfully? %}<p role="status">Thanks for subscribing!</p>{% else %}<label for="NewsletterEmail">Your email address</label><div class="store-newsletter__fields"><input id="NewsletterEmail" type="email" name="contact[email]" placeholder="you@example.com" autocomplete="email" required><button type="submit">{{ section.settings.button_label | escape }} →</button></div>{% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}{% endif %}{% endform %}</div></div></section>
{% schema %}{"name":"Newsletter signup","settings":[{"type":"text","id":"eyebrow","label":"Small heading","default":"THE RA BIKER CLUB"},{"type":"text","id":"heading","label":"Heading","default":"More happy moments, straight to your inbox."},{"type":"textarea","id":"description","label":"Description","default":"Sign up for pet care inspiration, new arrivals and store news. Unsubscribe any time."},{"type":"text","id":"button_label","label":"Submit button text","default":"Join the club"}],"presets":[{"name":"Newsletter signup"}]}{% endschema %}