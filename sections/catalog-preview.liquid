<section class="catalog-preview page-width" aria-labelledby="CatalogPreviewTitle"><div class="section-heading"><div><p class="eyebrow">EXPLORE THE COLLECTION</p><h2 id="CatalogPreviewTitle">{{ section.settings.heading | escape }}</h2><p>{{ section.settings.description | escape }}</p></div><a href="{{ routes.all_products_collection_url }}">Shop all products →</a></div><div class="catalog-preview__grid">{% for block in section.blocks %}{% assign item = block.settings.product %}<article class="catalog-preview__card" {{ block.shopify_attributes }}><div class="catalog-preview__photo">{% if item != blank and item.featured_image != blank %}{{ item.featured_image | image_url: width: 650 | image_tag: loading: 'lazy' }}{% elsif block.settings.image != blank %}{{ block.settings.image | image_url: width: 650 | image_tag: loading: 'lazy' }}{% else %}<div class="catalog-preview__placeholder"><span aria-hidden="true">{{ block.settings.symbol }}</span></div>{% endif %}</div><div class="catalog-preview__body"><span class="catalog-preview__tag">{{ block.settings.tag | escape }}</span><h3>{% if item != blank %}{{ item.title | escape }}{% else %}{{ block.settings.title | escape }}{% endif %}</h3><p>{{ block.settings.description | escape }}</p>{% if item != blank %}<p class="catalog-preview__price">{{ item.price | money }}</p><a href="{{ item.url }}" class="catalog-preview__link">View product →</a>{% else %}<span class="catalog-preview__coming">Collection preview · Product coming soon</span>{% endif %}</div></article>{% endfor %}</div></section>
{% schema %}{"name":"Catalog previews","settings":[{"type":"text","id":"heading","label":"Heading","default":"Find their next favorite."},{"type":"text","id":"description","label":"Description","default":"From everyday meals to playful discoveries, there is more to explore."}],"blocks":[{"type":"item","name":"Catalog item","settings":[{"type":"product","id":"product","label":"Real Shopify product (enables purchase link)"},{"type":"image_picker","id":"image","label":"Preview photo"},{"type":"text","id":"symbol","label":"Placeholder icon","default":"🐾"},{"type":"text","id":"tag","label":"Category label","default":"PET ESSENTIALS"},{"type":"text","id":"title","label":"Preview title","default":"Pet favorite"},{"type":"text","id":"description","label":"Description","default":"Discover more for your companion."}]}],"max_blocks":12,"presets":[{"name":"Catalog previews","blocks":[{"type":"item","settings":{"title":"Dog food & treats","tag":"DOGS","symbol":"🥣","description":"Delicious meals and little rewards."}},{"type":"item","settings":{"title":"Cat food & treats","tag":"CATS","symbol":"🐟","description":"Everyday meals for curious cats."}},{"type":"item","settings":{"title":"Toys & play","tag":"PLAYTIME","symbol":"🎾","description":"More fetch, chase and fun."}},{"type":"item","settings":{"title":"Cozy beds","tag":"COMFORT","symbol":"🛏️","description":"Soft spots for sweet dreams."}},{"type":"item","settings":{"title":"Grooming care","tag":"CARE","symbol":"🧴","description":"Everyday grooming essentials."}},{"type":"item","settings":{"title":"Bowls & feeding","tag":"MEALTIME","symbol":"💧","description":"Useful favorites for feeding time."}}]}]}{% endschema %}