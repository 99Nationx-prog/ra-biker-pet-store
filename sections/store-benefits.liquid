<section class="store-benefits page-width" aria-label="{{ section.settings.heading | default: 'Pet shopping highlights' | escape }}">{% if section.settings.heading != blank %}<h2 class="store-benefits__heading">{{ section.settings.heading | escape }}</h2>{% endif %}<div class="store-benefits__grid">{% for block in section.blocks %}<a class="store-benefit" href="{{ block.settings.link | default: block.settings.collection.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}<span class="store-benefit__photo">{{ block.settings.image | image_url: width: 220 | image_tag: loading: 'lazy' }}</span>{% else %}<span class="store-benefit__icon" aria-hidden="true">{{ block.settings.icon | escape }}</span>{% endif %}<div><h2>{{ block.settings.title | escape }}</h2><p>{{ block.settings.description | escape }} <span aria-hidden="true">→</span></p></div></a>{% endfor %}</div></section>
{% schema %}{"name":"Shop by pet highlights","settings":[{"type":"text","id":"heading","label":"Optional heading"}],"blocks":[{"type":"highlight","name":"Highlight","settings":[{"type":"text","id":"title","label":"Heading","default":"Everything for pets"},{"type":"textarea","id":"description","label":"Description","default":"Explore the collection"},{"type":"text","id":"icon","label":"Emoji icon","default":"🐾"},{"type":"image_picker","id":"image","label":"Optional photo"},{"type":"collection","id":"collection","label":"Linked collection"},{"type":"url","id":"link","label":"Custom link"}]}],"max_blocks":12,"presets":[{"name":"Shop by pet highlights","blocks":[{"type":"highlight"},{"type":"highlight"},{"type":"highlight"}]}]}{% endschema %}