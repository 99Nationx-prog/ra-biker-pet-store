<section class="store-promise"><div class="page-width store-promise__inner">{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}<h2>{{ section.settings.heading | escape }}</h2><div class="rte">{{ section.settings.description }}</div>{% if section.settings.button_label != blank %}<a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} →</a>{% endif %}{% if section.settings.image != blank %}<div class="store-promise__photo">{{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy' }}</div>{% endif %}</div></section>
{% schema %}{"name":"Our store story","settings":[{"type":"text","id":"eyebrow","label":"Small heading","default":"WELCOME TO RA BIKER PET STORE"},{"type":"text","id":"heading","label":"Heading","default":"Because they're more than pets. They're family."},{"type":"richtext","id":"description","label":"Description","default":"<p>We believe the little things matter: a toy that makes playtime exciting, a comfortable place to curl up, and the everyday essentials that help you care for your best friend. Whether you're shopping for a playful pup or a curious cat, RA BIKER brings their needs together in one easy-to-shop place.</p>"},{"type":"text","id":"button_label","label":"Button text","default":"Explore the store"},{"type":"url","id":"button_link","label":"Button link"},{"type":"image_picker","id":"image","label":"Optional photo"}],"presets":[{"name":"Our store story"}]}{% endschema %}