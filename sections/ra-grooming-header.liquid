<style>.rag-ann{background:#0f4a2e;color:white;display:flex;justify-content:center;gap:12px;padding:8px 4px;font:600 clamp(10px,2.5vw,15px) Arial;text-align:center}.rag-ann a{color:inherit}.rag-head{display:flex;align-items:center;justify-content:space-between;padding:9px 4%;background:#faf6ec;color:#0f4a2e;position:relative}.rag-head a{color:inherit;text-decoration:none}.rag-brand{font:bold clamp(23px,5vw,38px) Georgia,serif;display:flex;align-items:center;gap:5px}.rag-actions{display:flex;align-items:center;gap:18px}.rag-actions svg{width:25px;height:25px;display:block}.rag-actions summary{list-style:none;cursor:pointer}.rag-actions summary::-webkit-details-marker{display:none}.rag-menu{position:absolute;right:4%;top:100%;z-index:100;background:#faf6ec;border:1px solid #0f4a2e;padding:16px;min-width:180px;box-shadow:0 5px 15px #0002}.rag-menu a{display:block;padding:8px}.rag-cart{position:relative}.rag-count{position:absolute;right:-9px;top:-8px;background:#e8912d;color:white;border-radius:50%;min-width:17px;text-align:center;font:12px Arial}.rag-ann{gap:0;padding:8px 3%;background:#073e29}.rag-ann span{display:flex;align-items:center;justify-content:center;gap:5px;flex:1;white-space:nowrap;padding:0 5px}.rag-ann span+span{border-left:1px solid #fff9}.rag-ann svg{flex:none}.rag-brand{letter-spacing:-.04em}.rag-head{padding:8px 4%}.rag-actions{gap:18px}@media(max-width:420px){.rag-ann{font-size:9px}.rag-ann svg{width:13px;height:13px}.rag-actions{gap:13px}}</style>
<div class="rag-ann">{% for i in (1..3) %}{% assign key = 'notice' | append: i %}{% if section.settings[key] != blank %}<span><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">{% case i %}{% when 1 %}<path d="M2 4h13v13H2zM15 8h4l3 4v5h-7"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/>{% when 2 %}<path d="m12 2 9 4v7c0 5-9 9-9 9S3 18 3 13V6zM7 11l4 4 6-7"/>{% when 3 %}<path d="m12 2 9 4v7c0 5-9 9-9 9S3 18 3 13V6zM7 11l4 4 6-7"/>{% endcase %}</svg>{{ section.settings[key] | escape }}</span>{% endif %}{% endfor %}</div>
<header class="rag-head"><a class="rag-brand" href="{{ routes.root_url }}"><svg width="30" height="30" viewBox="0 0 40 40" fill="currentColor" aria-hidden="true"><ellipse cx="8" cy="13" rx="5" ry="7" transform="rotate(-25 8 13)"/><ellipse cx="19" cy="7" rx="5" ry="7"/><ellipse cx="30" cy="12" rx="5" ry="7" transform="rotate(25 30 12)"/><ellipse cx="36" cy="23" rx="4" ry="6"/><path d="M20 17C13 17 4 29 7 34c3 6 10 1 14 1s11 5 14-1c3-5-8-17-15-17Z"/></svg>{{ section.settings.brand | escape }}</a><div class="rag-actions"><a href="{{ routes.search_url }}" aria-label="Search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="10" cy="10" r="7"/><path d="m15 15 7 7"/></svg></a><a class="rag-cart" href="{{ routes.cart_url }}" aria-label="Cart"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 2h3l4 14h12l3-10H5"/><circle cx="9" cy="21" r="1"/><circle cx="19" cy="21" r="1"/></svg><span class="rag-count">{{ cart.item_count }}</span></a><details><summary aria-label="Menu"><svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M1 5h22M1 12h22M1 19h22"/></svg></summary><nav class="rag-menu"><a href="{{ routes.root_url }}">Home</a><a href="{{ routes.all_products_collection_url }}">Shop</a><a href="/pages/contact">Contact</a><a href="{{ routes.cart_url }}">Cart</a>{% if shop.shipping_policy %}<a href="{{ shop.shipping_policy.url }}">Shipping</a>{% endif %}{% if shop.refund_policy %}<a href="{{ shop.refund_policy.url }}">Returns</a>{% endif %}</nav></details></div></header>
{% schema %}{"name":"Grooming header","settings":[{"type":"text","id":"brand","label":"Brand","default":"Ra Biker"},{"type":"text","id":"notice1","label":"Announcement 1","default":"U.S. Shopping"},{"type":"text","id":"notice2","label":"Announcement 2","default":"Secure Checkout"},{"type":"text","id":"notice3","label":"Announcement 3","default":"Customer Support"}]}{% endschema %}